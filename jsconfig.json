{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "server.js",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public"
  ],
  "typeAcquisition": {
    "enable": false
  }
}
